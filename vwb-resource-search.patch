index 0000000..c84c609
--- /dev/null
+++ b/src/utils/resourceSearch.js
@@ -0,0 +1,182 @@
+// Resource search for the Community library.
+//
+// Why this exists: a plain "does the text contain the word" search misses
+// people who type "rides" when the resource says "transportation," or
+// "power bill" when it says "energy assistance." This file fixes that in
+// two ways:
+//   1. Word families. If someone types any word in a family, we also look
+//      for the others in that family.
+//   2. Plural and ending handling, so "ride" finds "rides" and "bills"
+//      finds "bill."
+//
+// To teach the search a new word, add it to a family below, or add a new
+// family. No database change needed.
+//
+// If a resource later gets a `keywords` column (text or array), it is
+// searched automatically and counts as a strong match.
+
+// Each list is one family. Add words freely. Lowercase, plain words.
+export const WORD_FAMILIES = [
+  // Rides and getting around
+  ['ride', 'riding', 'transportation', 'transport', 'transit', 'bus', 'shuttle', 'lift', 'carpool', 'van', 'taxi', 'cab', 'vehicle', 'medical transport', 'gas card', 'gas voucher', 'get to appointments'],
+
+  // Power, water, and other utility bills
+  ['power bill', 'electric bill', 'electric', 'electricity', 'power', 'utility', 'utilities', 'light bill', 'energy', 'energy assistance', 'gas bill', 'water bill', 'shutoff', 'shut off', 'disconnect', 'disconnection', 'liheap', 'georgia power', 'epb'],
+
+  // Rent and eviction
+  ['rent', 'rental', 'landlord', 'eviction', 'evict', 'lease', 'deposit', 'security deposit', 'back rent', 'past due', 'arrears', 'housing assistance', 'emergency rent'],
+
+  // A place to stay
+  ['housing', 'shelter', 'homeless', 'unhoused', 'place to stay', 'transitional', 'hotel voucher', 'sleep'],
+
+  // Food
+  ['food', 'groceries', 'grocery', 'pantry', 'hungry', 'hunger', 'meal', 'snap', 'food stamps', 'fridge', 'produce', 'lunch', 'dinner'],
+
+  // Legal help
+  ['legal', 'lawyer', 'attorney', 'court', 'legal aid', 'tenant rights', 'know your rights', 'sue'],
+
+  // Mold, flood, storm damage
+  ['mold', 'mildew', 'flood', 'flooding', 'water damage', 'storm', 'leak', 'damp', 'cleanup', 'tornado'],
+
+  // Recovery, mental health, crisis
+  ['recovery', 'addiction', 'sober', 'sobriety', 'rehab', 'detox', 'substance', 'drug', 'alcohol', 'mental health', 'counseling', 'therapy', 'crisis', 'hotline', '988'],
+
+  // Phone and internet
+  ['phone', 'cell', 'cellphone', 'lifeline', 'internet', 'wifi', 'broadband', 'data plan'],
+
+  // Laundry
+  ['laundry', 'laundromat', 'wash clothes', 'washer'],
+
+  // Babies and diapers
+  ['diaper', 'baby', 'formula', 'infant', 'newborn', 'wic'],
+
+  // Pets
+  ['pet', 'pet food', 'dog', 'cat', 'animal', 'vet', 'veterinary'],
+
+  // Clothes
+  ['clothes', 'clothing', 'coat', 'shoe', 'free store'],
+
+  // Medical
+  ['medicine', 'prescription', 'pharmacy', 'medication', 'doctor', 'clinic', 'dental', 'dentist'],
+]
+
+// Words we ignore in a search because they match almost everything.
+const STOPWORDS = new Set([
+  'help', 'assistance', 'need', 'needs', 'for', 'with', 'and', 'the', 'a', 'an',
+  'to', 'free', 'near', 'me', 'my', 'of', 'in', 'find', 'looking', 'i', 'get', 'can',
+])
+
+// Turns "rides" into "ride" and "bills" into "bill". Applied to both what
+// people type and what resources say, so they line up.
+export function stem(word) {
+  const w = String(word).toLowerCase()
+  if (w.length > 4 && w.endsWith('ies')) return w.slice(0, -3) + 'y'
+  if (w.length > 4 && /(ss|sh|ch|x|z)es$/.test(w)) return w.slice(0, -2)
+  if (w.length > 3 && w.endsWith('s') && !w.endsWith('ss')) return w.slice(0, -1)
+  if (w.length > 5 && w.endsWith('ing')) return w.slice(0, -3)
+  return w
+}
+
+function tokenize(text) {
+  return String(text || '')
+    .toLowerCase()
+    .replace(/[^a-z0-9\s]/g, ' ')
+    .split(/\s+/)
+    .filter(Boolean)
+    .map(stem)
+}
+
+// Families with every term already run through stem(), built once.
+const FAMILIES = WORD_FAMILIES.map(fam => fam.map(term => tokenize(term).join(' ')))
+
+function analyzeQuery(query) {
+  const tokens = tokenize(query)
+  const padded = ' ' + tokens.join(' ') + ' '
+  const related = new Set()
+  const covered = new Set()
+  for (const fam of FAMILIES) {
+    for (const term of fam) {
+      if (padded.includes(' ' + term + ' ')) {
+        fam.forEach(t => related.add(t))
+        term.split(' ').forEach(w => covered.add(w))
+      }
+    }
+  }
+  const leftover = tokens.filter(t => !covered.has(t) && !STOPWORDS.has(t))
+  return { tokens, related: [...related], leftover }
+}
+
+// The text of a resource, split by how strongly a match should count.
+function fieldsOf(r) {
+  const cats = (r.categories && r.categories.length) ? r.categories : (r.category ? [r.category] : [])
+  const kw = Array.isArray(r.keywords) ? r.keywords.join(' ') : (r.keywords || '')
+  return {
+    strong: [r.name, kw].filter(Boolean).join(' '),
+    medium: cats.join(' '),
+    weak: [r.description, r.requirements, r.neighborhood, r.address, r.organizations && r.organizations.name].filter(Boolean).join(' '),
+  }
+}
+
+function hasPhrase(hay, term) {
+  return hay.includes(' ' + term + ' ')
+}
+
+function hasPrefix(hay, token) {
+  return hay.split(' ').some(w => w.startsWith(token))
+}
+
+// 0 means no match. Higher means a better match.
+export function searchScore(resource, query) {
+  if (!String(query || '').trim()) return 1
+  const { tokens, related, leftover } = analyzeQuery(query)
+  if (tokens.length === 0) return 1
+
+  const f = fieldsOf(resource)
+  const hay = {
+    strong: ' ' + tokenize(f.strong).join(' ') + ' ',
+    medium: ' ' + tokenize(f.medium).join(' ') + ' ',
+    weak: ' ' + tokenize(f.weak).join(' ') + ' ',
+  }
+  const all = hay.strong + hay.medium + hay.weak
+
+  // Words that did not belong to a family must appear in the resource
+  // (typing "ringgold" should still narrow things down).
+  let leftoverScore = 0
+  if (related.length === 0) {
+    for (const t of leftover) {
+      if (!hasPrefix(all, t)) return 0
+      if (hasPrefix(hay.strong, t)) leftoverScore += 3
+      else if (hasPrefix(hay.medium, t)) leftoverScore += 2
+      else leftoverScore += 1
+    }
+    return leftover.length ? leftoverScore : 1
+  }
+
+  // With a family match, the resource needs at least one word from the
+  // family. Extra words in the search only add to the score.
+  let relatedScore = 0
+  for (const term of related) {
+    if (hasPhrase(hay.strong, term)) relatedScore += 3
+    else if (hasPhrase(hay.medium, term)) relatedScore += 2
+    else if (hasPhrase(hay.weak, term)) relatedScore += 1
+  }
+  if (relatedScore === 0) return 0
+  for (const t of leftover) {
+    if (hasPrefix(all, t)) leftoverScore += 1
+  }
+  return relatedScore + leftoverScore
+}
+
+export function resourceMatches(resource, query) {
+  return searchScore(resource, query) > 0
+}
+
+// Filter and sort a list. With no query, returns the list unchanged.
+export function searchResources(resources, query) {
+  if (!String(query || '').trim()) return resources
+  return resources
+    .map(r => ({ r, s: searchScore(r, query) }))
+    .filter(x => x.s > 0)
+    .sort((a, b) => b.s - a.s)
+    .map(x => x.r)
+}
